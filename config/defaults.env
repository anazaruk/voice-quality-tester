# Known defaults for a fresh lab/test installation.
# Change after validation if desired, but keep the application components consistent.

MYSQL_DATABASE=voice_quality
MYSQL_USER=nisqa
MYSQL_PASSWORD=CHANGE_ME

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional MaxMind GeoLite2 download credentials.
# If left blank, place GeoLite2-City.mmdb and GeoLite2-ASN.mmdb under ./geoip/
# before running install.sh.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# SIP trunks are authenticated by source IP. No SIP username/password is created.

# Auto-detected during install when blank.
PUBLIC_IP=
PRIVATE_IP=

# Reasonable cloud default. Override when needed.
ASTERISK_LOCALNET=10.0.0.0/8
