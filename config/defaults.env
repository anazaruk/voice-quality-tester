# Known defaults for a fresh lab/test installation.
# CHANGE THESE after validation.

MYSQL_DATABASE=voice_quality
MYSQL_USER=nisqa
MYSQL_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# SIP trunks are authenticated by source IP. No SIP username/password is created.

# Auto-detected during install when blank.
PUBLIC_IP=
PRIVATE_IP=

# Reasonable cloud default. Override when needed.
ASTERISK_LOCALNET=10.0.0.0/8
